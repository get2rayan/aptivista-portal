---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProcessFlow from "../components/ProcessFlow.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCollection } from "astro:content";

const isProd = import.meta.env.PROD;
const filterDrafts = (arr: any[]) =>
  isProd ? arr.filter((x) => !x.data.draft) : arr;

const solutions = filterDrafts(
  await getCollection("solutions")
).sort((a, b) => a.data.order - b.data.order);

const industries = filterDrafts(
  await getCollection("industries")
).sort((a, b) => a.data.order - b.data.order);

const posts = filterDrafts(await getCollection("insights")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => a.data.order - b.data.order
);

const engagementSteps = [
  { label: "Discover", desc: "We learn your stack, team, and the outcome you need." },
  { label: "Match", desc: "Vetted talent, or a delivery plan — calibrated to the work." },
  { label: "Deliver", desc: "We execute with stage gates you approve at every step." },
  { label: "Support", desc: "Ongoing support so what we ship keeps working." },
];

const stats = [
  { value: "100+", label: "Consultants placed" },
  { value: "20+", label: "Active Clients served" },
  { value: "3", label: "Services under one roof" },
  { value: "<2 days", label: "Avg. time to shortlist" },
];
---

<BaseLayout
  title="Aptivista Solutions"
  description="Aptivista Solutions — software staffing and solutions consultancy. We backfill open engineering roles and build client websites and applications under one roof."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow reveal">Software Staffing & Solutions</p>
        <h1 class="hero-title reveal">
          Talent that ships.<br />
          <span class="hero-accent">Solutions that scale.</span>
        </h1>
        <p class="hero-sub reveal">
          Aptivista Solutions helps you backfill critical engineering roles and
          build the websites and applications your business runs on — staffing,
          delivery, and consulting under one roof.
        </p>
        <div class="hero-actions reveal">
          <a href="/contact" class="btn btn-primary">Find your talent</a>
          <a href="/solutions" class="btn btn-outline">Explore solutions</a>
        </div>
        <div class="hero-stats reveal">
          {stats.map((s) => (
            <div class="stat">
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="hero-visual reveal" aria-hidden="true">
        <svg viewBox="0 0 480 420" class="hero-svg" role="img">
          <title>Talent matched to opportunity</title>
          <defs>
            <linearGradient id="line-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#0fb5a6" />
              <stop offset="100%" stop-color="#1e2a5e" />
            </linearGradient>
          </defs>
          <!-- connection lines -->
          <g stroke="url(#line-grad)" stroke-width="1.5" opacity="0.5">
            <path d="M70 90 C 200 90, 200 210, 330 210" fill="none" />
            <path d="M70 210 C 200 210, 200 210, 330 210" fill="none" />
            <path d="M70 330 C 200 330, 200 210, 330 210" fill="none" />
            <path d="M410 120 C 410 160, 380 190, 360 210" fill="none" />
            <path d="M410 330 C 410 290, 380 250, 360 220" fill="none" />
          </g>
          <!-- left nodes (talent) -->
          <g>
            <circle cx="70" cy="90" r="14" fill="#1e2a5e" />
            <circle cx="70" cy="210" r="14" fill="#1e2a5e" />
            <circle cx="70" cy="330" r="14" fill="#1e2a5e" />
          </g>
          <!-- center node (match) -->
          <circle cx="360" cy="210" r="34" fill="#0fb5a6" />
          <circle cx="360" cy="210" r="46" fill="none" stroke="#0fb5a6" stroke-opacity="0.35" stroke-width="2" />
          <!-- right targets -->
          <rect x="392" y="106" width="36" height="28" rx="6" fill="#1e2a5e" />
          <rect x="392" y="316" width="36" height="28" rx="6" fill="#1e2a5e" />
          <!-- floating dots -->
          <circle cx="200" cy="60" r="4" fill="#0fb5a6" />
          <circle cx="240" cy="370" r="4" fill="#0fb5a6" />
          <circle cx="300" cy="120" r="3" fill="#1e2a5e" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="section intro-section">
    <div class="container intro-grid">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2 class="intro-title">Staffing and solutions, without the handoff tax.</h2>
      </div>
      <div class="reveal">
        <p class="intro-body">
          Most companies juggle a recruiter and an agency. We do both. The team
          that scopes your work is the team that staffs it and builds it — so
          discovery happens once, calibration is real, and your outcomes aren't
          lost in a handoff.
        </p>
        <p class="intro-body">
          Whether you need to backfill a critical engineering role or ship a
          client website from scratch, Aptivista brings vetted talent and a
          delivery discipline that respects your time and budget.
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions preview -->
  <section class="section solutions-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">What we do</p>
        <h2 class="section-title">Three ways we help</h2>
        <p class="section-sub">
          Staffing, solutions engineering, and consulting — use one or combine
          them. They're designed to work together.
        </p>
      </div>
      <div class="cards-3">
        {solutions.map((s) => (
          <a href="/solutions" class="card solution-card reveal">
            <div class="solution-icon" aria-hidden="true">
              {s.data.icon === "users" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M16 19v-1a4 4 0 0 0-8 0v1M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM2 19v-1a4 4 0 0 1 4-4M22 19v-1a4 4 0 0 0-4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.data.icon === "code" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m8 6-6 6 6 6M16 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
              {s.data.icon === "compass" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="m16 8-2 6-6 2 2-6 6-2Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </div>
            <h3 class="card-title">{s.data.title}</h3>
            <p class="card-text">{s.data.summary}</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <ProcessFlow
    eyebrow="How we work"
    title="A disciplined engagement, every time"
    steps={engagementSteps}
  />

  <!-- Industries preview -->
  <section class="section industries-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Industries</p>
        <h2 class="section-title">Where we have depth</h2>
        <p class="section-sub">
          Engineers and delivery experience across the verticals that demand the
          most from software.
        </p>
      </div>
      <div class="industry-grid">
        {industries.map((ind) => (
          <a href="/industries" class="industry-chip reveal">
            <span class="industry-name">{ind.data.name}</span>
            <span class="industry-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Insights preview -->
  <section class="section insights-preview">
    <div class="container">
      <div class="section-head row reveal">
        <div>
          <p class="eyebrow">Insights</p>
          <h2 class="section-title">Field notes from the pipeline</h2>
        </div>
        <a href="/insights" class="see-all">All insights →</a>
      </div>
      <div class="cards-3">
        {posts.map((post) => (
          <a href={`/insights/${post.id}`} class="card article-card reveal">
            <div class="post-meta">
            <span class="badge">{post.data.category}</span>
            </div>
            <h3 class="card-title">{post.data.title}</h3>
            <p class="card-text">{post.data.description}</p>
            <div class="article-meta">
              <span>{post.data.author}</span>
              <span>·</span>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section testimonial-section">
    <div class="container testimonial-inner reveal">
      <svg class="quote-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 7h4v6c0 2-1 3-3 4M14 7h4v6c0 2-1 3-3 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <blockquote>
        {testimonials[0]?.data.quote ?? "Aptivista shortlisted strong engineers within a week — and they shipped."}
      </blockquote>
      <figcaption>
        <strong>{testimonials[0]?.data.name ?? "VP Engineering"}</strong>
        <span>{testimonials[0]?.data.role ?? ""}{testimonials[0]?.data.company ? `, ${testimonials[0].data.company}` : ""}</span>
      </figcaption>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 85% 15%, rgba(15, 181, 166, 0.12), transparent 45%),
      radial-gradient(circle at 10% 80%, rgba(30, 42, 94, 0.08), transparent 40%);
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.1fr 0.9fr; gap: 3rem; }
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin: 0.6rem 0 1rem;
    line-height: 1.05;
  }
  .hero-accent { color: var(--color-accent-700); }
  .hero-sub {
    font-size: 1.12rem;
    color: var(--color-ink-muted);
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }
  .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-stats {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 520px;
  }
  @media (min-width: 640px) { .hero-stats { grid-template-columns: repeat(4, 1fr); } }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat-value { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--color-primary); }
  .stat-label { font-size: 0.8rem; color: var(--color-ink-subtle); line-height: 1.3; }
  .hero-visual { display: none; }
  @media (min-width: 900px) { .hero-visual { display: block; } }
  .hero-svg { width: 100%; height: auto; }

  /* Intro */
  .intro-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .intro-grid { grid-template-columns: 1fr 1.3fr; gap: 3rem; } }
  .intro-title { font-size: clamp(1.6rem, 3.5vw, 2.2rem); }
  .intro-body { color: var(--color-ink-muted); font-size: 1.05rem; margin-bottom: 1rem; }

  /* Section heads */
  .section-head { max-width: 640px; margin-bottom: 2.5rem; }
  .section-head.row { display: flex; justify-content: space-between; align-items: flex-end; max-width: none; gap: 1rem; }
  .section-title { font-size: clamp(1.7rem, 4vw, 2.3rem); margin: 0.4rem 0 0.75rem; }
  .section-sub { color: var(--color-ink-muted); font-size: 1.05rem; }
  .see-all { font-weight: 600; white-space: nowrap; }

  /* Cards */
  .cards-3 { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cards-3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .cards-3 { grid-template-columns: repeat(3, 1fr); } }
  .solution-card, .article-card { text-decoration: none; display: flex; flex-direction: column; }
  .solution-icon {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--color-surface-muted);
    border-radius: var(--radius-sm);
    color: var(--color-accent-700);
    margin-bottom: 1rem;
  }
  .solution-icon svg { width: 24px; height: 24px; }
  .card-title { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .card-text { color: var(--color-ink-muted); font-size: 0.95rem; flex: 1; }
  .card-link { color: var(--color-accent-700); font-weight: 600; font-size: 0.9rem; margin-top: 1rem; }
  .article-meta { display: flex; gap: 0.4rem; align-items: center; font-size: 0.8rem; color: var(--color-ink-subtle); margin-top: 1rem; }
  .post-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; color: var(--color-ink-subtle); margin-bottom: 0.75rem; }

  /* Industries */
  .industry-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 640px) { .industry-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .industry-grid { grid-template-columns: repeat(3, 1fr); } }
  .industry-chip {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.1rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .industry-chip:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .industry-name { color: var(--color-primary); font-weight: 600; }
  .industry-arrow { color: var(--color-accent); }

  /* Testimonial */
  .testimonial-section { background: var(--color-surface-muted); }
  .testimonial-inner { max-width: 760px; text-align: center; }
  .quote-mark { width: 36px; height: 36px; color: var(--color-accent); margin: 0 auto 1rem; }
  .testimonial-inner blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
  }
  .testimonial-inner figcaption { display: flex; flex-direction: column; gap: 0.15rem; }
  .testimonial-inner figcaption strong { color: var(--color-ink); }
  .testimonial-inner figcaption span { color: var(--color-ink-subtle); font-size: 0.9rem; }
</style>
