---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const isProd = import.meta.env.PROD;
const posts = (await getCollection("insights"))
  .filter((p) => (isProd ? !p.data.draft : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Insights"
  description="Field notes from Aptivista on software staffing, delivery, and consulting — practical perspectives from the pipeline."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">Insights</p>
      <h1 class="page-title reveal">Field notes from the pipeline.</h1>
      <p class="page-lead reveal">
        Practical perspectives on staffing, building, and consulting — written
        by the people doing the work, not theorizing about it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {featured && (
        <a href={`/insights/${featured.id}`} class="featured-post reveal">
          <div class="featured-meta">
            <span class="badge">{featured.data.category}</span>
            <time datetime={featured.data.pubDate.toISOString()}>{fmtDate(featured.data.pubDate)}</time>
            {featured.data.readingTime && <span>· {featured.data.readingTime}</span>}
          </div>
          <h2 class="featured-title">{featured.data.title}</h2>
          <p class="featured-desc">{featured.data.description}</p>
          <span class="featured-author">By {featured.data.author}</span>
          <span class="featured-cta">Read article →</span>
        </a>
      )}

      <div class="post-grid">
        {rest.map((post) => (
          <a href={`/insights/${post.id}`} class="card post-card reveal">
            <div class="post-meta">
              <span class="badge">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
            </div>
            <h3 class="post-title">{post.data.title}</h3>
            <p class="post-excerpt">{post.data.description}</p>
            <div class="post-footer">
              <span>{post.data.author}</span>
              {post.data.readingTime && <span>· {post.data.readingTime}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem; }
  .page-lead { color: var(--color-ink-muted); max-width: 64ch; font-size: 1.1rem; }

  .featured-post {
    display: block;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-700) 100%);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 5vw, 3rem);
    margin-bottom: 2.5rem;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }
  .featured-post::before {
    content: "";
    position: absolute;
    top: -40px; right: -40px;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(15, 181, 166, 0.3), transparent 70%);
    border-radius: 50%;
  }
  .featured-post > * { position: relative; }
  .featured-meta { display: flex; gap: 0.5rem; align-items: center; color: #cdd5ea; font-size: 0.85rem; margin-bottom: 1rem; }
  .featured-meta .badge { background: rgba(15, 181, 166, 0.2); color: #7fe7dc; }
  .featured-title { color: #fff; font-size: clamp(1.5rem, 3.5vw, 2.2rem); margin-bottom: 0.75rem; }
  .featured-desc { color: #cdd5ea; font-size: 1.05rem; max-width: 60ch; margin-bottom: 1rem; }
  .featured-author { display: block; color: #aeb8d4; font-size: 0.9rem; margin-bottom: 1.25rem; }
  .featured-cta { color: var(--color-accent); font-weight: 600; }

  .post-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .post-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .post-grid { grid-template-columns: repeat(3, 1fr); } }

  .post-card { display: flex; flex-direction: column; text-decoration: none; }
  .post-meta { display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; color: var(--color-ink-subtle); margin-bottom: 0.75rem; }
  .post-title { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .post-excerpt { color: var(--color-ink-muted); font-size: 0.92rem; flex: 1; }
  .post-footer { display: flex; gap: 0.4rem; margin-top: 1rem; font-size: 0.8rem; color: var(--color-ink-subtle); }
</style>
