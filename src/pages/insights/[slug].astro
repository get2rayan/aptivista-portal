---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const isProd = import.meta.env.PROD;
  const posts = (await getCollection("insights")).filter((p) =>
    isProd ? !p.data.draft : true
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

// related posts
const isProd = import.meta.env.PROD;
const all = (await getCollection("insights")).filter((p) =>
  isProd ? !p.data.draft : true
);
const related = all
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 2);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <div class="container-narrow article-head">
      <a href="/insights" class="back-link">← All insights</a>
      <div class="article-meta reveal">
        <span class="badge">{post.data.category}</span>
        <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
        {post.data.readingTime && <span>· {post.data.readingTime}</span>}
      </div>
      <h1 class="article-title reveal">{post.data.title}</h1>
      <div class="author-block reveal">
        <span class="author-avatar" aria-hidden="true">{post.data.author.charAt(0)}</span>
        <div>
          <strong>{post.data.author}</strong>
          {post.data.authorRole && <span>{post.data.authorRole}</span>}
        </div>
      </div>
    </div>

    <div class="container-narrow article-body prose-aptivista reveal">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="section related-section">
      <div class="container">
        <h2 class="related-title">Related reading</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a href={`/insights/${p.id}`} class="card post-card reveal">
              <span class="badge">{p.data.category}</span>
              <h3 class="post-title">{p.data.title}</h3>
              <p class="post-excerpt">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand
    title="Have a role to fill or a build to scope?"
    text="We turn insights into action. Let's talk about your staffing or delivery need."
    primaryLabel="Talk to us"
    secondaryLabel="See solutions"
    secondaryHref="/solutions"
  />
</BaseLayout>

<style>
  .article { padding-block: clamp(2rem, 5vw, 3.5rem) 1rem; }
  .back-link { display: inline-block; margin-bottom: 1.5rem; font-weight: 600; color: var(--color-ink-muted); }
  .back-link:hover { color: var(--color-accent-700); }
  .article-meta { display: flex; gap: 0.5rem; align-items: center; color: var(--color-ink-subtle); font-size: 0.9rem; margin-bottom: 1rem; }
  .article-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); margin-bottom: 1.5rem; }
  .author-block { display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .author-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 700;
  }
  .author-block div { display: flex; flex-direction: column; }
  .author-block strong { color: var(--color-ink); }
  .author-block span { color: var(--color-ink-subtle); font-size: 0.85rem; }
  .article-body { padding-block: 2rem; }

  .related-section { background: var(--color-surface-muted); }
  .related-title { font-size: 1.4rem; margin-bottom: 1.75rem; }
  .related-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  .post-card { text-decoration: none; }
  .post-card .badge { margin-bottom: 0.75rem; }
  .post-title { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .post-excerpt { color: var(--color-ink-muted); font-size: 0.92rem; }
</style>
