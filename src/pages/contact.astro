---
import BaseLayout from "../layouts/BaseLayout.astro";
import Modal from "../components/Modal.astro";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Aptivista Solutions",
  description: "Software staffing and solutions consultancy.",
  areaServed: "US",
  knowsAbout: ["Software staffing", "IT augmentation", "Web development", "Consulting"],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "info@aptivista.com",
    areaServed: "US",
    availableLanguage: "English",
  },
};
---

<BaseLayout
  title="Contact"
  description="Talk to Aptivista Solutions about backfilling an engineering role or building a website or application. We respond within one business day."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="page-title reveal">Tell us what you need to fill or build.</h1>
      <p class="page-lead reveal">
        Whether you're backfilling a critical role or scoping a new build, tell
        us a bit about it. We'll come back within one business day with a plan.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <form class="contact-form reveal" data-form novalidate>
        <div class="field">
          <label for="name">Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Work email <span class="req">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="need">What do you need? <span class="req">*</span></label>
          <select id="need" name="need" required>
            <option value="">Select one…</option>
            <option value="staffing">Backfill a role / augmentation</option>
            <option value="project">Build a website or app</option>
            <option value="consulting">Consulting / advisory</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field field-full">
          <label for="message">Details <span class="req">*</span></label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us about the role or project, timeline, and stack if known."></textarea>
        </div>
        <!-- honeypot -->
        <div class="hp" aria-hidden="true">
          <label>Leave this empty<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn btn-primary submit-btn">Send message</button>
        <p class="form-status" data-status role="status" aria-live="polite"></p>
      </form>

      <aside class="contact-aside reveal">
        <div class="aside-card">
          <h2>Reach us directly</h2>
          <ul class="aside-list">
            <li>
              <span class="aside-label">Email</span>
              <a href="mailto:info@aptivista.com">info@aptivista.com</a>
            </li>
            <!-- <li>
              <span class="aside-label">Careers</span>
              <a href="mailto:info@aptivista.com">info@aptivista.com</a>
            </li> -->
            <!-- <li>
              <span class="aside-label">Location</span>
              <span>Oviedo, Florida, US</span>
            </li> -->
            <li>
              <span class="aside-label">Response time</span>
              <span>Within one business day</span>
            </li>
          </ul>
        </div>
        <div class="aside-note">
          <p>Prefer email? Reach out directly and skip the form — we read every message.</p>
        </div>
      </aside>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <Modal id="thank-you-modal" redirectTo="/">
    <div class="modal-icon" aria-hidden="true">✓</div>
    <h2 class="modal-title">Thank you!</h2>
    <p class="modal-message">We've received your message. We'll be in touch with you shortly.</p>
    <button class="modal-btn" data-modal-close>Got it</button>
  </Modal>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  .page-title { font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0 1rem; }
  .page-lead { color: var(--color-ink-muted); max-width: 64ch; font-size: 1.1rem; }

  .contact-grid { display: grid; gap: 2rem; }
  @media (min-width: 860px) { .contact-grid { grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; } }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (max-width: 560px) { .contact-form { grid-template-columns: 1fr; } }
  .field { display: flex; flex-direction: column; gap: 0.35rem; }
  .field-full { grid-column: 1 / -1; }
  .field label { font-size: 0.85rem; font-weight: 600; color: var(--color-ink); }
  .req { color: var(--color-error); }
  .field input, .field select, .field textarea {
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-size: 0.98rem;
    font-family: inherit;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    border-color: var(--color-accent);
    outline: none;
  }
  .field input.invalid, .field select.invalid, .field textarea.invalid {
    border-color: var(--color-error);
  }
  .field textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; }
  .submit-btn { grid-column: 1 / -1; justify-self: start; }
  .form-status { grid-column: 1 / -1; font-size: 0.9rem; margin: 0; }
  .form-status.success { color: var(--color-success); }
  .form-status.error { color: var(--color-error); }

  .aside-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
  }
  .aside-card h2 { font-size: 1.2rem; margin-bottom: 1.25rem; }
  .aside-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .aside-list li { display: flex; flex-direction: column; gap: 0.15rem; }
  .aside-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-ink-subtle); font-weight: 600; }
  .aside-list a { color: var(--color-accent-700); font-weight: 500; }
  .aside-note { margin-top: 1.25rem; padding: 1.25rem; background: var(--color-surface-muted); border-radius: var(--radius-md); }
  .aside-note p { margin: 0; color: var(--color-ink-muted); font-size: 0.92rem; }

  .modal-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-size: 1.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    margin: 0 auto 1rem;
  }
  .modal-title {
    color: var(--color-primary, #1e2a5e);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }
  .modal-message {
    color: var(--color-ink-muted);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
  .modal-btn {
    background: var(--color-primary, #1e2a5e);
    color: #fff;
    border: none;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-sm, 6px);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .modal-btn:hover {
    background: #15204a;
  }
</style>

<script>
  const form = document.querySelector("[data-form]") as HTMLFormElement | null;
  const status = document.querySelector("[data-status]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
        // // Show the Modal component
        // //const modal = (window as any).__modals?.["thank-you-modal"];
        // const modal = document.querySelector("#thank-you-modal") as HTMLDialogElement | null;
        // modal?.showModal();
    if (!status) return;
    const data = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]');
    const sendText = submitBtn?.textContent || "Send Message";
    // honeypot
    if ((data.get("company_website") as string)?.trim()) {
      status.textContent = "";
      return;
    }
    const required = ["name", "email", "need", "message"];
    let valid = true;
    required.forEach((name) => {
      const el = form.querySelector(`[name="${name}"]`) as HTMLElement;
      if (!el) return;
      const ok = String(data.get(name) ?? "").trim().length > 0;
      el.classList.toggle("invalid", !ok);
      if (!ok) valid = false;
    });
    const email = String(data.get("email") ?? "");
    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
    const emailEl = form.querySelector('[name="email"]') as HTMLElement;
    emailEl?.classList.toggle("invalid", !emailOk);
    if (!emailOk) valid = false;

    if (!valid) {
      status.textContent = "Please fill in the required fields with a valid email.";
      status.className = "form-status error";
      return;
    }
    // Web3Forms API key and reply-to email
    data.append("access_key", "ff3d20a7-3f4b-4f18-bf41-788fdb09d06e");
    data.set("replyto", data.get("email") as string);

    if (submitBtn) {
      submitBtn.setAttribute("disabled", "true");
      submitBtn.textContent = "Sending…";
    }

    // Send the Contact form data to Web3Forms
    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: data,
      });
      const result = await response.json();
      if (result.success) {
        status.textContent = "";
        status.className = "";
        // Show the Modal component
        const modal = document.querySelector("#thank-you-modal") as HTMLDialogElement | null;
        modal?.showModal();
      } else {
        status.textContent = "There was an error sending your message. Please try again later.";
        status.className = "form-status error";
      }
    } catch (error) {
      status.textContent = "Network error. Please try again or email us directly.";
      status.className = "form-status error";
      console.log("Form submission error:", error);
    } finally {
      if (submitBtn) {
        submitBtn.removeAttribute("disabled");
        submitBtn.textContent = sendText;
      }
    }
  });
</script>
