---
interface Props {
  variant?: "default" | "light";
  class?: string;
}
const { variant = "default", class: className = "" } = Astro.props;
---

<a
  href="/"
  class={`logo ${className}`}
  aria-label="Aptivista Solutions home"
  style={`--logo-color: ${variant === "light" ? "#ffffff" : "var(--color-primary)"}`}
>
  <img src="/favicon-32x32.png" alt="Aptivista Solutions logo" width="32" height="32" />
  <span class="logo-text">Aptivista<span class="logo-dot">.</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }
  .logo-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.8rem;
    letter-spacing: -0.02em;
    color: var(--logo-color);
  }
  .logo-dot {
    color: var(--color-accent);
  }
</style>
