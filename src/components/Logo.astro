---
interface Props {
  variant?: "default" | "light";
  class?: string;
}
const { variant = "default", class: className = "" } = Astro.props;
---

<a
  href="/"
  class={`logo ${className}`}
  aria-label="Aptivista Solutions home"
  style={`--logo-color: ${variant === "light" ? "#ffffff" : "var(--color-primary)"}`}
>
