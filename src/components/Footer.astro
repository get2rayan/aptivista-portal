---
import Logo from "./Logo.astro";
const year = new Date().getFullYear();

const columns = [
  {
    title: "Solutions",
    links: [
      { href: "/solutions", label: "Staffing & Augmentation" },
      { href: "/solutions", label: "Solutions Engineering" },
      { href: "/solutions", label: "Consulting" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/industries", label: "Industries" },
      { href: "/careers", label: "Careers" },
      { href: "/insights", label: "Insights" },
    ],
  },
  {
    title: "Connect",
    links: [
      { href: "/contact", label: "Contact" },
      { href: "mailto:info@aptivista.com", label: "info@aptivista.com" },
      { href: "https://www.linkedin.com/company/aptivistasolutions", label: "LinkedIn", icon: "linkedin" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="light" />
      <p class="footer-tag">
        Talent that ships. Solutions that scale. Software staffing and solutions
        under one roof.
      </p>
    </div>
    {columns.map((col) => (
      <div class="footer-col">
        <h3 class="footer-title">{col.title}</h3>
        <ul>
          {col.links.map((l) => (
            <li>
              <a href={l.href} class={l.icon ? "footer-link-with-icon" : ""}>
                {l.icon === "linkedin" && (
                  <svg class="footer-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                )}
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container footer-bottom">
    <p>&copy; {year} Aptivista Solutions. All rights reserved.</p>
    <!-- <p class="footer-loc">Oviedo, Florida, US</p> -->
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: #cdd5ea;
    padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
    margin-top: 4rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-tag {
    margin-top: 1rem;
    max-width: 32ch;
    color: #aeb8d4;
    font-size: 0.95rem;
  }
  .footer-title {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.6rem; }
  .footer-col a {
    color: #cdd5ea;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover { color: var(--color-accent); }
  .footer-link-with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }
  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: #8a96bb;
  }
  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; }
  }
</style>
