<style>
  .modal {
    border: none;
    border-radius: var(--radius-lg, 12px);
    padding: 0;
    max-width: 420px;
    width: 90%;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    /* Ensure centering — Tailwind's reset may strip dialog defaults */
    margin: auto;
  }
  .modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
    animation: fade-in 0.2s ease;
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .modal[open] {
    animation: modal-in 0.3s ease;
  }
  @keyframes modal-in {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .modal-content {
    padding: 2.5rem 2rem;
    text-align: center;
  }
</style>