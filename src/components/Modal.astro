---
export interface Props {
  /** Unique ID for this modal instance */
  id?: string;
  /** URL to redirect to on dismiss (default: "/") */
  redirectTo?: string;
}

const { id, redirectTo = "/" } = Astro.props;
---

<dialog id={id} class="modal" data-redirect-to={redirectTo} data-modal>
  <div class="modal-content">
    <slot />
  </div>
</dialog>

<script>
    const dialog = document.querySelector("[data-modal]")! as HTMLDialogElement;
        // Close on backdrop click
        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) dialog.close();
        });
        // Close on [data-modal-close] button inside the slot
        dialog.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target.closest("[data-modal-close]")) dismiss();
        });
        // Redirect on close (Esc key or programmatic close)
        dialog.addEventListener("close", () => {
            window.location.href = dialog.getAttribute("data-redirect-to") || "/";
        });

      function dismiss() {
        dialog.close();
      }

